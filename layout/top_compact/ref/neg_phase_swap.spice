* ---- top level ----
.subckt dsm_top vdda gnd clk vin vrp vrn vcm q qb g out
Xxclk clk p1a p1ab p1 p1b p2 p2b cc vdda gnd clkgen
Xxvcm vcm vdda gnd vdda gnd vcm_replica
Xxsin vin b p1 p1b vdda gnd tg_x0p5_mf
Xxst1 vcm t p2 p2b vdda gnd tg_x0p5_mf
Xxst2 t g p2 p2b vdda gnd tg_x0p5_mf
Xxsb2 dac b p2 p2b vdda gnd tg_x0p5_mf
Xxdp vrp dac q qb vdda gnd tg_x0p5_mf
Xxdn vrn dac qb q vdda gnd tg_x0p5_mf
Xxcap g t b out cap_array
Xxota vdda gnd g out vdda gnd ota_core
Xxcmp out vcm cc q qb vdda gnd comp
.ends
